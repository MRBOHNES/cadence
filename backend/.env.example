# Postgres connection string. Neon's plain postgresql://...?sslmode=require URL works as-is.
DATABASE_URL=postgresql+asyncpg://cadence:cadence@localhost:5432/cadence
# Shared secret the GitHub Actions cron sends as X-Cron-Secret. Generate with: openssl rand -hex 32
CRON_SECRET=change-me
# The only browser origin allowed to call the API (your Vercel URL in production).
CORS_ORIGIN=http://localhost:3000
